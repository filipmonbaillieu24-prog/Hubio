{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith",
  "version": "0.1.1",
  "identifier": "com.zenith.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zenith Ecosysteem",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer_header.jpg",
        "sidebarImage": "icons/installer_sidebar.jpg"
      }
    }
  },
  "plugins": {
    "opener": {},
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/filipmonbaillieu24-prog/Zenith/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMTA4OUFDNEZDM0ExRDMKUldUVG9jTlBySWtRcnFsWThXQyttODFQMzFaS0NMVTIrRzRmMEFOVTFxS3VNS0FZVWs1UW9CUkQK"
    }
  }
}
